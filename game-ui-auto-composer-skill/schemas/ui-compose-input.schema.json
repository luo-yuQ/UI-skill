{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/ui-compose-input.schema.json",
  "title": "UI Compose Input",
  "description": "Input contract for composing an engine-neutral UI plan from pre-analyzed assets and a user request. The consumer must not inspect or reinterpret source images.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0",
      "description": "Version of the UI compose input contract."
    },
    "request": {
      "$ref": "#/$defs/request"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "description": "Pre-analyzed assets. Asset analysis is authoritative input and must be consumed without reopening or reinterpreting source images.",
      "items": {
        "$ref": "#/$defs/asset_input"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_\\-]*$"
    },
    "game_description": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "genre",
        "gameplay_summary"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "genre": {
          "type": "string",
          "minLength": 1
        },
        "gameplay_summary": {
          "type": "string",
          "minLength": 1
        },
        "core_interaction": {
          "type": [
            "string",
            "null"
          ]
        },
        "audience": {
          "type": [
            "string",
            "null"
          ]
        },
        "style_keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "requested_page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_id",
        "page_type",
        "goal",
        "requirements"
      ],
      "properties": {
        "page_id": {
          "$ref": "#/$defs/identifier"
        },
        "page_type": {
          "type": "string",
          "enum": [
            "login",
            "loading",
            "home",
            "main_menu",
            "gameplay",
            "hud",
            "settings",
            "result",
            "mode_select",
            "level_select",
            "popup",
            "other"
          ]
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "priority": {
          "type": "string",
          "enum": [
            "primary",
            "secondary",
            "supporting"
          ],
          "default": "primary"
        }
      }
    },
    "page_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_page_id",
        "pages"
      ],
      "properties": {
        "primary_page_id": {
          "$ref": "#/$defs/identifier"
        },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/requested_page"
          }
        },
        "flow_description": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "target_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "unit": {
          "type": "string",
          "const": "px",
          "default": "px"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "game_description",
        "page_request",
        "orientation",
        "target_resolution"
      ],
      "properties": {
        "game_description": {
          "$ref": "#/$defs/game_description"
        },
        "page_request": {
          "$ref": "#/$defs/page_request"
        },
        "orientation": {
          "type": "string",
          "enum": [
            "portrait",
            "landscape",
            "square"
          ]
        },
        "target_resolution": {
          "$ref": "#/$defs/target_resolution"
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        },
        "visual_preferences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "description": "Opaque reference for downstream retrieval of the original asset. It must not be opened or used to repeat visual analysis during UI composition.",
      "required": [
        "ref_type",
        "value"
      ],
      "properties": {
        "ref_type": {
          "type": "string",
          "enum": [
            "workspace_path",
            "attachment_id",
            "asset_uri",
            "opaque_id"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "media_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "checksum": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional integrity checksum supplied by the upstream system."
        }
      }
    },
    "asset_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_analysis",
        "source_ref"
      ],
      "properties": {
        "asset_analysis": {
          "description": "Authoritative upstream analysis. Consume as structured facts without reading the referenced image. A stable asset_id is required by the compose layer.",
          "allOf": [
            {
              "$ref": "asset-analysis.schema.json"
            },
            {
              "required": [
                "asset_id"
              ]
            }
          ]
        },
        "source_ref": {
          "$ref": "#/$defs/source_ref"
        },
        "request_notes": {
          "type": "array",
          "description": "User requirements about how this already-analyzed asset may be used. These notes do not authorize renewed image analysis.",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        }
      }
    }
  }
}
