{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/ui-compose-input.schema.json",
  "title": "UI Compose Input v2",
  "description": "Breaking-change input contract for synthesizing a new engine-neutral UI design intent from a user requirement, an authoritative A layout-reference final analysis, and an authoritative B2 style profile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request",
    "layout_reference_analysis",
    "style_profile"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "2.0"},
    "request": {"$ref": "#/$defs/request"},
    "layout_reference_analysis": {
      "description": "Complete authoritative A final analysis. Consume it as layout evidence; do not summarize it into a private Composer contract or reopen its source screenshot.",
      "$ref": "https://example.com/schemas/layout-reference-analysis.schema.json"
    },
    "style_profile": {
      "description": "Complete authoritative B2 style profile. Consume its classified traits as visual-style evidence; do not reopen its source images.",
      "$ref": "https://example.com/schemas/style-profile.schema.json"
    }
  },
  "$defs": {
    "non_empty_text": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "target_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "unit": {"type": "string", "const": "px", "default": "px"}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_requirement"],
      "properties": {
        "user_requirement": {
          "$ref": "#/$defs/non_empty_text",
          "description": "Ordinary-language target requirement authoritative for business purpose, content, counts, interactions, explicit layout changes, and explicit visual changes."
        },
        "project_name": {"type": ["string", "null"], "minLength": 1},
        "game_context": {"type": ["string", "null"], "minLength": 1},
        "page_context": {"type": ["string", "null"], "minLength": 1},
        "orientation": {
          "type": ["string", "null"],
          "enum": ["portrait", "landscape", "square", null]
        },
        "target_resolution": {
          "anyOf": [
            {"$ref": "#/$defs/target_resolution"},
            {"type": "null"}
          ]
        },
        "constraints": {
          "type": "array",
          "items": {"$ref": "#/$defs/non_empty_text"},
          "uniqueItems": true,
          "default": []
        },
        "visual_preferences": {
          "type": "array",
          "items": {"$ref": "#/$defs/non_empty_text"},
          "uniqueItems": true,
          "default": []
        }
      }
    }
  }
}
