{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/ui-compose-plan.schema.json",
  "title": "UI Compose Plan v2.1.1",
  "description": "A strict requirement-preserving engine-neutral UI design intent synthesized from a user requirement, A layout evidence, and B2 visual-style evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_context",
    "design_summary",
    "reference_application",
    "visual_direction",
    "pages",
    "component_tree",
    "layout_rules",
    "interactions",
    "navigation",
    "generation_constraints",
    "assumptions",
    "warnings"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "2.1.1"},
    "project_context": {"$ref": "#/$defs/project_context"},
    "design_summary": {"$ref": "#/$defs/design_summary"},
    "reference_application": {"$ref": "#/$defs/reference_application"},
    "visual_direction": {"$ref": "#/$defs/visual_direction"},
    "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page"}},
    "component_tree": {
      "type": "array",
      "minItems": 1,
      "description": "Flat ordered representation of the newly designed page trees, not renamed copies of A groups.",
      "items": {"$ref": "#/$defs/component"}
    },
    "layout_rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/layout_rule"}},
    "interactions": {"type": "array", "items": {"$ref": "#/$defs/interaction"}},
    "navigation": {"type": "array", "items": {"$ref": "#/$defs/navigation_rule"}},
    "generation_constraints": {"$ref": "#/$defs/generation_constraints"},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/assumption"}},
    "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"}}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9_\\-]*$"},
    "text": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "text_array": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "identifier_array": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
    "target_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "unit"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "unit": {"type": "string", "const": "px"}
      }
    },
    "project_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_name", "user_requirement", "game_context", "orientation", "target_resolution", "page_scope", "constraints", "hard_requirements"],
      "properties": {
        "project_name": {"type": ["string", "null"], "minLength": 1},
        "user_requirement": {"$ref": "#/$defs/text"},
        "game_context": {"type": ["string", "null"], "minLength": 1},
        "orientation": {"type": ["string", "null"], "enum": ["portrait", "landscape", "square", null]},
        "target_resolution": {"anyOf": [{"$ref": "#/$defs/target_resolution"}, {"type": "null"}]},
        "page_scope": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "constraints": {"$ref": "#/$defs/text_array"},
        "hard_requirements": {"$ref": "#/$defs/hard_requirements"}
      }
    },
    "requirement_evidence": {
      "type": "string",
      "minLength": 1,
      "description": "Exact substring copied from project_context.user_requirement."
    },
    "semantic_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "value", "evidence"],
      "properties": {
        "fact_id": {"$ref": "#/$defs/identifier"},
        "value": {"$ref": "#/$defs/identifier"},
        "evidence": {"$ref": "#/$defs/requirement_evidence"}
      }
    },
    "count_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "target_component_id", "count", "evidence"],
      "properties": {
        "fact_id": {"$ref": "#/$defs/identifier"},
        "target_component_id": {"$ref": "#/$defs/identifier"},
        "count": {"type": "integer", "minimum": 0},
        "evidence": {"$ref": "#/$defs/requirement_evidence"}
      }
    },
    "grid_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "target_component_id", "columns", "rows", "evidence"],
      "properties": {
        "fact_id": {"$ref": "#/$defs/identifier"},
        "target_component_id": {"$ref": "#/$defs/identifier"},
        "columns": {"type": "integer", "minimum": 1},
        "rows": {"type": "integer", "minimum": 1},
        "evidence": {"$ref": "#/$defs/requirement_evidence"}
      }
    },
    "element_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "target_component_id", "semantic", "position", "evidence"],
      "properties": {
        "fact_id": {"$ref": "#/$defs/identifier"},
        "target_component_id": {"$ref": "#/$defs/identifier"},
        "semantic": {"$ref": "#/$defs/identifier"},
        "position": {"type": ["string", "null"], "enum": ["top", "left", "right", "bottom", "center", null]},
        "evidence": {"$ref": "#/$defs/requirement_evidence"}
      }
    },
    "hard_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_semantic", "explicit_counts", "grid_requirements", "required_elements", "must_include", "must_not_include"],
      "properties": {
        "page_semantic": {"$ref": "#/$defs/semantic_requirement"},
        "explicit_counts": {"type": "array", "items": {"$ref": "#/$defs/count_requirement"}},
        "grid_requirements": {"type": "array", "items": {"$ref": "#/$defs/grid_requirement"}},
        "required_elements": {"type": "array", "items": {"$ref": "#/$defs/element_requirement"}},
        "must_include": {"$ref": "#/$defs/text_array"},
        "must_not_include": {"$ref": "#/$defs/text_array"}
      }
    },
    "design_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_experience", "synthesis_summary", "key_design_decisions"],
      "properties": {
        "target_experience": {"$ref": "#/$defs/text"},
        "synthesis_summary": {"$ref": "#/$defs/text"},
        "key_design_decisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}
      }
    },
    "layout_reference_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "origin", "source_kind", "source_ids", "source_meaning", "disposition", "target_application", "rationale"],
      "properties": {
        "decision_id": {"$ref": "#/$defs/identifier"},
        "origin": {"type": "string", "enum": ["layout_reference", "user_requirement", "composer_derived"]},
        "source_kind": {"type": ["string", "null"], "enum": ["region", "region_relationship", "component_group", "visual_hierarchy", "layout_rule", "excluded_content", "uncertainty", null]},
        "source_ids": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "source_meaning": {"type": ["string", "null"], "minLength": 1},
        "disposition": {"type": "string", "enum": ["adopted", "adapted", "ignored", "rejected"]},
        "target_application": {"type": ["string", "null"], "minLength": 1},
        "rationale": {"$ref": "#/$defs/text"}
      },
      "allOf": [
        {
          "if": {"properties": {"origin": {"const": "layout_reference"}}, "required": ["origin"]},
          "then": {
            "properties": {
              "source_kind": {"type": "string"},
              "source_ids": {"minItems": 1},
              "source_meaning": {"type": "string"}
            }
          },
          "else": {
            "properties": {
              "source_kind": {"const": null},
              "source_ids": {"maxItems": 0},
              "source_meaning": {"const": null}
            }
          }
        }
      ]
    },
    "style_reference_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "origin", "trait_id", "dimension", "classification", "disposition", "target_scope", "target_application", "promoted_by_user_requirement", "promotion_evidence", "rationale"],
      "properties": {
        "decision_id": {"$ref": "#/$defs/identifier"},
        "origin": {"type": "string", "enum": ["style_reference", "user_requirement", "composer_derived"]},
        "trait_id": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "dimension": {"type": "string", "enum": ["color", "material", "shape", "rendering", "lighting", "decoration", "world_visual", "surface_treatment"]},
        "classification": {"type": ["string", "null"], "enum": ["stable", "secondary", "local", "conflicting", "uncertain", null]},
        "disposition": {"type": "string", "enum": ["adopted", "conditionally_adopted", "ignored", "rejected_due_to_conflict", "overridden_by_user"]},
        "target_scope": {"$ref": "#/$defs/identifier_array"},
        "target_application": {"type": ["string", "null"], "minLength": 1},
        "promoted_by_user_requirement": {"type": "boolean"},
        "promotion_evidence": {"type": ["string", "null"], "minLength": 1},
        "rationale": {"$ref": "#/$defs/text"}
      },
      "allOf": [
        {
          "if": {"properties": {"origin": {"const": "style_reference"}}, "required": ["origin"]},
          "then": {
            "properties": {
              "trait_id": {"$ref": "#/$defs/identifier"},
              "classification": {"type": "string"}
            }
          },
          "else": {
            "properties": {
              "trait_id": {"const": null},
              "classification": {"const": null},
              "promoted_by_user_requirement": {"const": false},
              "promotion_evidence": {"const": null}
            }
          }
        }
      ]
    },
    "reference_application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout_analysis_id", "style_profile_id", "layout", "style"],
      "properties": {
        "layout_analysis_id": {"$ref": "#/$defs/identifier"},
        "style_profile_id": {"$ref": "#/$defs/identifier"},
        "layout": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/layout_reference_decision"}},
        "style": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/style_reference_decision"}}
      }
    },
    "visual_directive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directive_id", "dimension", "direction", "source_trait_ids", "target_scope", "user_override", "notes"],
      "properties": {
        "directive_id": {"$ref": "#/$defs/identifier"},
        "dimension": {"type": "string", "enum": ["color", "material", "shape", "rendering", "lighting", "decoration", "world_visual", "surface_treatment"]},
        "direction": {"$ref": "#/$defs/text"},
        "source_trait_ids": {"$ref": "#/$defs/identifier_array"},
        "target_scope": {"$ref": "#/$defs/identifier_array"},
        "user_override": {"type": "boolean"},
        "notes": {"$ref": "#/$defs/text_array"}
      }
    },
    "visual_direction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "directives", "hierarchy_emphasis", "page_specific_notes"],
      "properties": {
        "summary": {"$ref": "#/$defs/text"},
        "directives": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/visual_directive"}},
        "hierarchy_emphasis": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "page_specific_notes": {"$ref": "#/$defs/text_array"}
      }
    },
    "page_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_id", "description", "is_initial"],
      "properties": {
        "state_id": {"$ref": "#/$defs/identifier"},
        "description": {"$ref": "#/$defs/text"},
        "is_initial": {"type": "boolean"}
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page_id", "page_type", "purpose", "root_component_id", "states", "entry_conditions", "exit_conditions"],
      "properties": {
        "page_id": {"$ref": "#/$defs/identifier"},
        "page_type": {"$ref": "#/$defs/identifier"},
        "purpose": {"$ref": "#/$defs/text"},
        "root_component_id": {"$ref": "#/$defs/identifier"},
        "states": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page_state"}},
        "entry_conditions": {"$ref": "#/$defs/text_array"},
        "exit_conditions": {"$ref": "#/$defs/text_array"}
      }
    },
    "component_content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {"type": ["string", "null"]},
        "text_role": {"type": ["string", "null"], "minLength": 1},
        "data_role": {"type": ["string", "null"], "minLength": 1},
        "accessibility_label": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "repeat_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "arrangement", "columns", "rows", "content_variation"],
      "properties": {
        "count": {"type": "integer", "minimum": 1},
        "arrangement": {"type": "string", "enum": ["row", "column", "grid", "list", "carousel", "custom"]},
        "columns": {"type": ["integer", "null"], "minimum": 1},
        "rows": {"type": ["integer", "null"], "minimum": 1},
        "content_variation": {"$ref": "#/$defs/text"}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "page_id", "parent_id", "name", "semantic_type", "order", "state_ids", "design_intent", "notes"],
      "properties": {
        "component_id": {"$ref": "#/$defs/identifier"},
        "page_id": {"$ref": "#/$defs/identifier"},
        "parent_id": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "name": {"$ref": "#/$defs/text"},
        "semantic_type": {"type": "string", "enum": ["page_root", "container", "panel", "navigation", "list", "grid", "item", "button", "text", "status", "overlay", "decoration", "custom"]},
        "order": {"type": "integer", "minimum": 0},
        "state_ids": {"$ref": "#/$defs/identifier_array"},
        "design_intent": {"$ref": "#/$defs/text"},
        "content": {"$ref": "#/$defs/component_content"},
        "repeat": {"$ref": "#/$defs/repeat_spec"},
        "notes": {"$ref": "#/$defs/text_array"}
      }
    },
    "normalized_point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "unit"],
      "properties": {
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0},
        "unit": {"type": "string", "enum": ["normalized_parent", "logical_pixel"]}
      }
    },
    "layout_relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationship_type", "target_component_id", "description"],
      "properties": {
        "relationship_type": {"type": "string", "enum": ["left_of", "right_of", "above", "below", "inside", "centered_within", "aligned_with", "spaced_from", "overlays", "repeated_within"]},
        "target_component_id": {"$ref": "#/$defs/identifier"},
        "description": {"$ref": "#/$defs/text"}
      }
    },
    "layout_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "page_id", "component_id", "relative_to", "anchor", "pivot", "position", "dimensions", "stack_order", "safe_area_policy", "relationships", "content_adaptation", "notes"],
      "properties": {
        "rule_id": {"$ref": "#/$defs/identifier"},
        "page_id": {"$ref": "#/$defs/identifier"},
        "component_id": {"$ref": "#/$defs/identifier"},
        "relative_to": {"type": "string", "enum": ["canvas", "safe_area", "parent"]},
        "anchor": {"type": "string", "enum": ["top_left", "top_center", "top_right", "center_left", "center", "center_right", "bottom_left", "bottom_center", "bottom_right", "stretch"]},
        "pivot": {"$ref": "#/$defs/normalized_point"},
        "position": {"$ref": "#/$defs/normalized_point"},
        "dimensions": {"$ref": "#/$defs/dimensions"},
        "stack_order": {"type": "integer"},
        "safe_area_policy": {"type": "string", "enum": ["inside", "may_extend", "full_bleed", "not_applicable"]},
        "relationships": {"type": "array", "items": {"$ref": "#/$defs/layout_relationship"}},
        "content_adaptation": {"$ref": "#/$defs/text_array"},
        "notes": {"$ref": "#/$defs/text_array"}
      }
    },
    "state_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "from_state", "to_state"],
      "properties": {
        "target_id": {"$ref": "#/$defs/identifier"},
        "from_state": {"$ref": "#/$defs/identifier"},
        "to_state": {"$ref": "#/$defs/identifier"}
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interaction_id", "page_id", "trigger_component_id", "trigger", "action", "conditions", "state_changes", "navigation_id", "feedback"],
      "properties": {
        "interaction_id": {"$ref": "#/$defs/identifier"},
        "page_id": {"$ref": "#/$defs/identifier"},
        "trigger_component_id": {"$ref": "#/$defs/identifier"},
        "trigger": {"type": "string", "enum": ["tap", "click", "press", "release", "long_press", "submit", "value_change", "automatic"]},
        "action": {"$ref": "#/$defs/identifier"},
        "conditions": {"$ref": "#/$defs/text_array"},
        "state_changes": {"type": "array", "items": {"$ref": "#/$defs/state_change"}},
        "navigation_id": {"anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]},
        "feedback": {"$ref": "#/$defs/text_array"}
      }
    },
    "navigation_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["navigation_id", "from_page_id", "to_page_id", "trigger_interaction_id", "transition_style", "history_behavior", "notes"],
      "properties": {
        "navigation_id": {"$ref": "#/$defs/identifier"},
        "from_page_id": {"$ref": "#/$defs/identifier"},
        "to_page_id": {"$ref": "#/$defs/identifier"},
        "trigger_interaction_id": {"$ref": "#/$defs/identifier"},
        "transition_style": {"type": "string", "enum": ["immediate", "fade", "slide", "overlay", "custom"]},
        "transition_duration_ms": {"type": ["integer", "null"], "minimum": 0},
        "history_behavior": {"type": "string", "enum": ["push", "replace", "clear"]},
        "notes": {"$ref": "#/$defs/text_array"}
      }
    },
    "exact_count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "count", "requirement"],
      "properties": {
        "component_id": {"$ref": "#/$defs/identifier"},
        "count": {"type": "integer", "minimum": 0},
        "requirement": {"$ref": "#/$defs/text"}
      }
    },
    "content_zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "content_role", "requirement"],
      "properties": {
        "component_id": {"$ref": "#/$defs/identifier"},
        "content_role": {"$ref": "#/$defs/identifier"},
        "requirement": {"$ref": "#/$defs/text"}
      }
    },
    "grid_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "columns", "rows", "requirement"],
      "properties": {
        "component_id": {"$ref": "#/$defs/identifier"},
        "columns": {"type": "integer", "minimum": 1},
        "rows": {"type": "integer", "minimum": 1},
        "requirement": {"$ref": "#/$defs/text"}
      }
    },
    "generation_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["must_include", "must_not_include", "exact_counts", "grid_specs", "key_content_zones", "focal_hierarchy", "component_separability", "overlap_restrictions", "readability_requirements", "clean_boundary_requirements", "cutout_friendly_requirements", "reference_fidelity_boundaries"],
      "properties": {
        "must_include": {"$ref": "#/$defs/text_array"},
        "must_not_include": {"$ref": "#/$defs/text_array"},
        "exact_counts": {"type": "array", "items": {"$ref": "#/$defs/exact_count"}},
        "grid_specs": {"type": "array", "items": {"$ref": "#/$defs/grid_spec"}},
        "key_content_zones": {"type": "array", "items": {"$ref": "#/$defs/content_zone"}},
        "focal_hierarchy": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
        "component_separability": {"$ref": "#/$defs/text_array"},
        "overlap_restrictions": {"$ref": "#/$defs/text_array"},
        "readability_requirements": {"$ref": "#/$defs/text_array"},
        "clean_boundary_requirements": {"$ref": "#/$defs/text_array"},
        "cutout_friendly_requirements": {"$ref": "#/$defs/text_array"},
        "reference_fidelity_boundaries": {"$ref": "#/$defs/text_array"}
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assumption_id", "statement", "basis", "impact", "confidence"],
      "properties": {
        "assumption_id": {"$ref": "#/$defs/identifier"},
        "statement": {"$ref": "#/$defs/text"},
        "basis": {"type": "string", "enum": ["user_ambiguity", "layout_uncertainty", "style_uncertainty", "design_completion"]},
        "impact": {"$ref": "#/$defs/text"},
        "confidence": {"$ref": "#/$defs/confidence"}
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warning_id", "severity", "category", "message", "related_ids"],
      "properties": {
        "warning_id": {"$ref": "#/$defs/identifier"},
        "severity": {"type": "string", "enum": ["info", "warning", "error"]},
        "category": {"type": "string", "enum": ["user_layout_conflict", "user_style_deviation", "style_conflict", "low_confidence_evidence", "orientation_adaptation", "insufficient_requirement", "reference_scope"]},
        "message": {"$ref": "#/$defs/text"},
        "related_ids": {"$ref": "#/$defs/identifier_array"}
      }
    }
  }
}
