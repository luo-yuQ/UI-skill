{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "direct-assets.schema.json",
  "title": "Direct Asset Discovery output (Stage2-A1, immutable VLM output)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_image",
    "source_image_size",
    "analysis_image",
    "analysis_image_size",
    "assets"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "source_image": {"type": "string"},
    "source_image_size": {"$ref": "#/$defs/image_size"},
    "analysis_image": {"type": "string"},
    "analysis_image_size": {"$ref": "#/$defs/image_size"},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "taxonomy",
          "bbox_analysis",
          "bbox_source",
          "partial",
          "confidence"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^asset_[0-9]{3,}$"},
          "label": {"type": "string", "minLength": 1},
          "taxonomy": {"type": "string", "minLength": 1},
          "bbox_analysis": {"$ref": "#/$defs/bbox"},
          "bbox_source": {"$ref": "#/$defs/bbox"},
          "partial": {"type": "boolean"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  },
  "$defs": {
    "image_size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "bbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    }
  }
}
